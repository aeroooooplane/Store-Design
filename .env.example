# Copy to .env and fill in local values. Never commit .env.

# Database. pglite://<dir> runs an embedded PostgreSQL (no install, dev/test only);
# use postgres://user:password@host:5432/dbname for a real PostgreSQL server.
DATABASE_URL=pglite://./data/pglite

# API server
API_HOST=127.0.0.1
API_PORT=3001
# Browser origin allowed by CORS (the Vite dev server).
WEB_ORIGIN=http://127.0.0.1:5173
# development | test | production
NODE_ENV=development
LOG_LEVEL=info

# File locations (relative paths resolve from the repository root).
STORAGE_ROOT=./data/files
RESOURCE_ROOT=./资源库
ARCHIVE_ROOT=./data/archive

# AI providers (keys stay on the server; leave empty to disable a provider).
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
# Overseas providers stay hidden until network compliance is confirmed.
ENABLE_OVERSEAS_MODELS=false
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_CNY=50
